<ui:PanelWindow x:Class="DeskMon.VersionsWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:DeskMon.Ui"
                Title="Versions"
                Width="440" Height="400"
                MinWidth="300" MinHeight="180"
                ShowInTaskbar="False"
                ShowActivated="False"
                TextOptions.TextFormattingMode="Display"
                FontFamily="Consolas">

    <ui:PanelWindow.Resources>
        <ResourceDictionary Source="Ui/PanelStyles.xaml" />
    </ui:PanelWindow.Resources>

    <Border x:Name="Panel" CornerRadius="10" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <Grid x:Name="HeaderBar" DockPanel.Dock="Top" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0"
                           Text="VERSIONS"
                           Margin="12,8,8,6"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,6,0">
                    <Button Style="{StaticResource PanelButton}"
                            Content="&#x2715;" ToolTip="Close&#x0a;Closes the window - it opens again where you left it." Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="HeaderRule" DockPanel.Dock="Top" Height="1" Margin="12,0,12,0" />

            <!-- The running version, whether a newer one is out, and what
                 DeskMon needs installed, as cards - the same cards as the
                 session history's PLAYTIME FROM SAVES and LOGGED (Ui/StatCard),
                 so the windows read alike. Above the history rather than in it,
                 so they don't scroll away. Filled in code (ShowCards); wraps in
                 a narrow window. -->
            <WrapPanel x:Name="Stats" DockPanel.Dock="Top" Margin="12,8,4,0" />

            <!-- How to install whatever is missing, one line each - only when
                 something is, since that does need reading. -->
            <StackPanel x:Name="Requirements" DockPanel.Dock="Top" Margin="12,0,12,0" />
            <Border x:Name="RequirementsRule" DockPanel.Dock="Top" Height="1" Margin="12,0,12,0" />

            <!-- Scrolls rather than sizing to content: the list only grows, and
                 a window that grew with it would eventually be taller than the
                 screen. Built in code - a heading per day that folds its
                 releases away - see BuildHistory. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="12,6,4,10">
                <StackPanel x:Name="History" Margin="0,0,8,0" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</ui:PanelWindow>
