<Window x:Class="DeskMon.ToolsPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMon - install tools"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" SizeToContent="Height" Width="430">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ui/PanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The offer to install what DeskMon is missing - see ToolsPrompt.xaml.cs. -->
    <Border x:Name="Card" CornerRadius="8" BorderThickness="1" Padding="16,14" Margin="6"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Heading" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel x:Name="Tools" />
            <TextBlock x:Name="Fine" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <!-- Width Auto: PanelButton is the toolbar's icon style, 26 wide. -->
                <Button x:Name="NoButton" Style="{StaticResource PanelButton}" Content="NO THANKS" Width="Auto"
                        Margin="0,0,6,0" Padding="10,3" Click="No_Click" />
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Content="INSTALL"
                        Padding="12,3" Click="Install_Click" />
                <Button x:Name="RestartButton" Style="{StaticResource AccentButton}" Content="RESTART DESKMON"
                        Padding="12,3" Margin="6,0,0,0" Click="Restart_Click" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
