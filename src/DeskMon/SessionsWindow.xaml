<ui:PanelWindow x:Class="DeskMon.SessionsWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:DeskMon.Ui"
                Title="Sessions"
                Width="580" Height="560"
                MinWidth="460" MinHeight="320"
                ShowInTaskbar="False"
                ShowActivated="False"
                TextOptions.TextFormattingMode="Display">

    <ui:PanelWindow.Resources>
        <ResourceDictionary Source="Ui/PanelStyles.xaml" />
    </ui:PanelWindow.Resources>

    <!-- The session history, game by game: what the log files hold, as a
         summary, a chart and a table. Read-only - the files are the record,
         and this only reads them. -->
    <Border x:Name="Panel" CornerRadius="10" BorderThickness="1">
        <Grid>
        <!-- The game's picture behind the top of the window, fading out
             before the chart, as Steam's library page shows a game. Under
             everything, so it never takes a click. Set in code (GameArt). -->
        <Border x:Name="Backdrop" VerticalAlignment="Top" Height="270"
                CornerRadius="9,9,0,0" IsHitTestVisible="False" Opacity="0">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#C0000000" Offset="0.45" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <DockPanel LastChildFill="True">

            <Grid x:Name="HeaderBar" DockPanel.Dock="Top" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0"
                           Text="SESSIONS"
                           Margin="12,8,8,6"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,6,0">
                    <Button Style="{StaticResource PanelButton}"
                            Content="&#x2715;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="HeaderRule" DockPanel.Dock="Top" Height="1" Margin="12,0,12,0" />

            <!-- What can be done here, in the row every window has under its
                 header (ActionRow, in PanelStyles.xaml). -->
            <StackPanel Style="{StaticResource ActionRow}" Orientation="Horizontal">
                <!-- A circle not quite closed, with its arrowhead: read again. -->
                <Button Style="{StaticResource ToolButton}"
                        ToolTip="Reload the logs&#x0a;Picks up changes made to them in Notepad."
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M8.5,5 A3.5,3.5 0 1 1 7,2.2
                                    M7.5,0.5 V2.5 H5.5" />
                        <TextBlock Text="REFRESH" />
                    </StackPanel>
                </Button>

                <!-- A table: a box split into three columns. -->
                <Button x:Name="ColumnsButton" Style="{StaticResource ToolButton}"
                        ToolTip="Choose which readings the table shows"
                        Click="Columns_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M0.5,1.5 H9.5 V8.5 H0.5 Z
                                    M3.5,1.5 V8.5 M6.5,1.5 V8.5" />
                        <TextBlock Text="COLUMNS" />
                    </StackPanel>
                </Button>

                <!-- The notes button's page, with lines of text on it: a log. -->
                <Button x:Name="OpenLogButton" Style="{StaticResource ToolButton}"
                        ToolTip="Open this game&apos;s log file in Notepad"
                        Click="OpenLog_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M2.5,0.5 H6.5 L8.5,2.5 V9.5 H2.5 Z
                                    M6.5,0.5 V2.5 H8.5
                                    M4,5.5 H7 M4,7.5 H7" />
                        <TextBlock Text="OPEN LOG" />
                        <Path Style="{StaticResource OpensWindowMark}" />
                    </StackPanel>
                </Button>

                <!-- A tray with an arrow coming down into it: saved to a file.
                     Saves rather than opens a window, so no ↗ mark. The format
                     in the label, so it is clear before clicking what comes out. -->
                <Button x:Name="ExportButton" Style="{StaticResource ToolButton}"
                        ToolTip="Save the sessions as a CSV file&#x0a;For a spreadsheet - every session in the table, with its averages, score and peaks.&#x0a;Under All games, every game&apos;s sessions in one file."
                        Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M5,0.5 V6.5 M2.5,4 L5,6.5 L7.5,4
                                    M0.5,6.5 V9.5 H9.5 V6.5" />
                        <TextBlock Text="EXPORT CSV" />
                    </StackPanel>
                </Button>

                <!-- A bin: lid with a handle, and a body with two ribs. -->
                <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}"
                        IsEnabled="False"
                        ToolTip="Delete the selected sessions&#x0a;Click a session in the table first - Ctrl+click picks more than one."
                        ToolTipService.ShowOnDisabled="True"
                        Click="Delete_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M1.5,2.5 H9.5 M4.5,2.5 V0.5 H6.5 V2.5
                                    M2.5,2.5 V9.5 H8.5 V2.5
                                    M4.5,4.5 V7.5 M6.5,4.5 V7.5" />
                        <TextBlock x:Name="DeleteText" Text="DELETE" />
                    </StackPanel>
                </Button>

                <!-- The same bin with a cross through its body: everything goes. -->
                <Button x:Name="DeleteAllButton" Style="{StaticResource ToolButton}"
                        IsEnabled="False"
                        ToolTip="Delete every session of this game&#x0a;Its whole log - other games are not touched."
                        ToolTipService.ShowOnDisabled="True"
                        Click="DeleteAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M1.5,2.5 H9.5 M4.5,2.5 V0.5 H6.5 V2.5
                                    M2.5,2.5 V9.5 H8.5 V2.5
                                    M4,4.5 L7,7.5 M7,4.5 L4,7.5" />
                        <TextBlock x:Name="DeleteAllText" Text="DELETE ALL" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Under the actions, as the notes' picker is. No "Game" label
                 before it: the list of games, with their icons, says what it
                 picks, and the label only took width from it. -->
            <Grid DockPanel.Dock="Top" Margin="12,0,12,0">
                <ComboBox x:Name="GamePicker"
                          Style="{StaticResource DarkCombo}"
                          ItemTemplate="{StaticResource GamePickerItem}"
                          ItemContainerStyle="{StaticResource GamePickerRow}"
                          SelectionChanged="GamePicker_SelectionChanged"
                          VerticalAlignment="Center" />
            </Grid>

            <!-- Totals for the game: the question this window answers first is
                 "how much have I played this?". -->
            <!-- The figures, each on a small card of its own with its name
                 above it: what it is in small capitals, how much in larger
                 bright type. They used to be one sentence of bright and dim
                 words, which had to be read through to find a number. Filled
                 in code; wraps onto a second row in a narrow window. -->
            <!-- Two columns and no rows: everything on the left in one stack,
                 the date chips and the game's logo in one on the right. Rows
                 shared between the two sides let the logo's height leak into
                 the left side as a gap under the cards that no margin could
                 close, so each side now stacks on its own and only the
                 margins set here space it. -->
            <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The right side: dates at the top, logo at the bottom. A
                 DockPanel, so the two add up rather than overlap when the
                 left side is short - under All games, with no chart. -->
            <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- In the top right corner, opposite the cards: first and last
                 played for a game, most and last played for All games, as
                 chips stacked right-aligned (filled in ShowSummary and
                 ShowAllGamesSummary). Under the cards they pushed the chart
                 down and sat between two rows of figures they have nothing to
                 do with; here they use the room the cards leave free. The
                 cards don't reach into this column, so the two never overlap -
                 the cards wrap sooner instead. -->
            <StackPanel x:Name="Dates" DockPanel.Dock="Top" Margin="8,10,16,0"
                        VerticalAlignment="Top" HorizontalAlignment="Right" />

            <!-- Which game, at the bottom right of its banner: the game's own
                 logo where Steam has one, else its name in large type over a
                 short accent bar. Set in code with the banner. As tall as the
                 tallest logo whatever it holds, so the chart below stays
                 where it is when one game has a logo and the next only its
                 name. The logo or name opens the game's Steam page; the grid
                 itself has no background, so only they take the click. -->
            <Grid x:Name="GameTitle"
                  VerticalAlignment="Bottom" HorizontalAlignment="Right"
                  Height="96" Margin="8,6,16,4" Opacity="0">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.9" Color="Black" />
                </Grid.Effect>
                <!-- The badge in its own column, left of the logo: the hand
                     cursor and the hover grow only showed it was a button once
                     the mouse was already on it. In a column rather than a
                     negative margin, so it takes room of its own and can't
                     overlap the chart heading beside it. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- On top (ZIndex) and kept clear by more than the hover grow:
                     the logo grows leftward from its right edge, and a wide one
                     grew over the badge and hid it just as it was wanted. -->
                <Border x:Name="GameLinkBadge" Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                        BorderThickness="1" Margin="0,0,18,2" Opacity="0.75" Panel.ZIndex="1"
                        VerticalAlignment="Bottom" Visibility="Collapsed"
                        MouseEnter="GameTitle_MouseEnter" MouseLeave="GameTitle_MouseLeave"
                        MouseLeftButtonUp="GameTitle_Click">
                    <Path x:Name="GameLinkIcon" Width="10" Height="10" Stretch="None"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M1.5,8.5 L8.5,1.5 M3.5,1.5 H8.5 V6.5" />
                </Border>
                <!-- 240 x 96, up from 190 x 76: the logo is what names the game
                     here, and at the old size a wide one was a thin strip. -->
                <Image x:Name="GameLogo" Grid.Column="1" MaxWidth="240" MaxHeight="96" Stretch="Uniform"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="1,1"
                       MouseEnter="GameTitle_MouseEnter" MouseLeave="GameTitle_MouseLeave"
                       MouseLeftButtonUp="GameTitle_Click" />
                <StackPanel x:Name="GameNamePanel" Grid.Column="1" VerticalAlignment="Bottom"
                            RenderTransformOrigin="1,1" Background="Transparent"
                            MouseEnter="GameTitle_MouseEnter" MouseLeave="GameTitle_MouseLeave"
                            MouseLeftButtonUp="GameTitle_Click">
                    <Border x:Name="GameNameBar" Width="26" Height="3" CornerRadius="1.5"
                            HorizontalAlignment="Right" Margin="0,0,0,5" />
                    <TextBlock x:Name="GameName" MaxWidth="170" TextWrapping="Wrap"
                               TextAlignment="Right" HorizontalAlignment="Right"
                               FontFamily="Bahnschrift SemiBold, Segoe UI" FontSize="21"
                               LineHeight="22" LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </Grid>
            </DockPanel>

            <!-- The left side, top to bottom. -->
            <StackPanel Grid.Column="0">

            <WrapPanel x:Name="Stats" Margin="12,10,4,0" />

            <!-- Under the cards, a line of text - why there is nothing to
                 show, or an error. -->
            <TextBlock x:Name="SummaryText" Margin="12,0,12,0" TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- One bar per session, oldest on the left. Drawn in code, and
                 redrawn when the window is resized. The picker is the title, so
                 what the bars measure is said where the choice is made. -->
            <!-- Stacked, not in a row: PER SESSION and its chips first, right
                 under LAST SESSION's so the two blocks of figures line up on
                 the left as a pair, then the picker on a line of its own
                 just over the chart it picks for. -->
            <!-- 6 on top plus the cards' own 8 under them, and 14 over the
                 picker: the two blocks sit centred between the cards and the
                 picker. -->
            <StackPanel x:Name="ChartTitle"
                        Margin="12,6,12,4">
                <!-- The latest session at a glance - when, how long, its
                     frame rate and score - with a heading like PER SESSION's
                     (filled in ShowSummary). In the same panel as PER SESSION,
                     so the two read as a pair. -->
                <StackPanel x:Name="LastSessionPanel" Visibility="Collapsed">
                    <TextBlock x:Name="LastSessionTitle" Text="LAST SESSION" Margin="2,0,0,3" />
                    <WrapPanel x:Name="LastSession" />
                </StackPanel>
                <!-- "Per session" as the heading over the chips it describes,
                     not a loose phrase between the picker and them: beside
                     the picker it read as part of the reading's name. -->
                <StackPanel x:Name="ChipsPanel" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <TextBlock x:Name="ChartTitleText" Text="PER SESSION" Margin="2,0,0,3" />
                    <StackPanel Orientation="Horizontal">
                        <!-- Each figure in a chip of its own colour: the key, a small
                             caption and the figure itself, larger. Three loose lines
                             of small text in a row read as one sentence and were hard
                             to pick a number out of. Colours and fonts in ApplyTheme,
                             the figures in DrawChart.

                             The average over the bars drawn, so the chart can be read
                             as one figure without adding the bars up by eye. Each chip
                             has a small icon in its mark's colour - the average's is a
                             dashed line, as it is drawn across the chart, not a bar. -->
                        <Border x:Name="AverageChip" Margin="0,0,0,0" Padding="9,3,10,3"
                                ToolTip="The average of the sessions in the chart - the dashed green line across it.&#x0a;For Average FPS weighted by how long each session ran, as the AVERAGE card is."
                                CornerRadius="9" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- A wavy line with a dashed level through it: the bars
                                     going up and down, and the average line the chart
                                     draws across them. Coloured in code, as the line is. -->
                                <Grid Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path x:Name="AverageIconWave" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0.5,8.5 C2.5,2.5 4,2.5 6,6 S9.5,9.5 11.5,3.5" />
                                    <Path x:Name="AverageIconLine" StrokeThickness="1" StrokeDashArray="2,1.5"
                                          Data="M0,6 H12" />
                                </Grid>
                                <TextBlock x:Name="AverageText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- The key for the one bar drawn in another colour, so the
                             colour is explained where it is seen, not in a tooltip. -->
                        <Border x:Name="HighestChip" Margin="8,0,0,0" Padding="9,3,10,3"
                                ToolTip="The highest session in the chart - its bar is drawn in this colour."
                                CornerRadius="9" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- A trend line climbing to an arrowhead: the best
                                     session. In the highest bar's own colour. -->
                                <Path x:Name="HighestIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                      StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0.5,10.5 L4,6.5 L6.5,8.5 L11,3.5 M7.5,3.5 H11 V7" />
                                <TextBlock x:Name="HighestText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- And the lowest, in a third colour. Only when it differs
                             from the highest: with one session, or every bar level,
                             there is no lowest to point out. -->
                        <Border x:Name="LowestChip" Margin="8,0,0,0" Padding="9,3,10,3"
                                ToolTip="The lowest session in the chart - its bar is drawn in this colour."
                                CornerRadius="9" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- The same falling: the worst session, in the lowest
                                     bar's colour. -->
                                <Path x:Name="LowestIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                      StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M0.5,2.5 L4,6.5 L6.5,4.5 L11,9.5 M7.5,9.5 H11 V6" />
                                <TextBlock x:Name="LowestText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <ComboBox x:Name="ChartPicker" Style="{StaticResource DarkCombo}"
                          MinWidth="150" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
            </StackPanel>
            </Grid>
            <!-- 160, up from 110: with the session IDs under the bars the plot
                 itself had grown too flat to tell sessions apart by height. -->
            <Canvas x:Name="Chart" DockPanel.Dock="Top" Height="160"
                    Margin="12,0,12,0" ClipToBounds="True"
                    Background="Transparent"
                    SizeChanged="Chart_SizeChanged" />

            <!-- One picked session over time, under the chart of every
                 session: where the chart says a session ran at 49 fps, this
                 says when. Shown with exactly one session picked - see
                 SessionsWindow.Timeline.cs. A panel rather than the tooltip,
                 so the line can be followed with the mouse. -->
            <StackPanel x:Name="TimelinePanel" DockPanel.Dock="Top" Margin="12,14,12,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="TimelineTitle" Text="SESSION TIMELINE" Margin="2,0,10,0" VerticalAlignment="Center" />
                    <StackPanel x:Name="TimelineToggles" DockPanel.Dock="Right" Orientation="Horizontal" />
                    <TextBlock x:Name="TimelineCaption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Canvas x:Name="TimelineChart" Height="120" Margin="0,6,0,0" ClipToBounds="True"
                        Background="Transparent"
                        SizeChanged="TimelineChart_SizeChanged"
                        MouseMove="TimelineChart_MouseMove" MouseLeave="TimelineChart_MouseLeave" />
            </StackPanel>

            <!-- All games: this week against last, and a calendar of the days
                 played - filled in SessionsWindow.Week.cs. -->
            <Grid x:Name="WeekPanel" DockPanel.Dock="Top" Margin="12,12,12,0" Visibility="Collapsed" />

            <!-- Between the chart and the table: a thin line in the accent,
                 strongest in the middle and fading out at both ends, so the
                 two read as separate parts without a hard box edge. The
                 table's first heading row sat right under the session IDs
                 before, and the two lines of small numbers ran together.
                 Shown and hidden with the chart - see DrawChart. -->
            <Border x:Name="ChartRule" DockPanel.Dock="Top" Height="1" Margin="24,14,24,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{DynamicResource Theme.AccentColor.14}" Offset="0" />
                        <GradientStop Color="{DynamicResource Theme.AccentColor.80}" Offset="0.5" />
                        <GradientStop Color="{DynamicResource Theme.AccentColor.14}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Column headings, outside the scroller so they stay put. -->
            <Grid x:Name="TableHeader" DockPanel.Dock="Top" Margin="12,12,12,2" />
            <Border x:Name="TableRule" DockPanel.Dock="Top" Height="1" Margin="12,0,12,0" />

            <!-- How to pick sessions, under the table: Ctrl+click was only in
                 Delete's tooltip, so picking several went unfound. Before the
                 scroller, which fills what is left. Shown for one game's
                 sessions only - see ShowRows. The arrow keys second, right
                 after clicking: switching the chart's reading by key would go
                 unfound like Ctrl+click did, and in a narrow window the end of
                 the line is cut off - the tooltip has all of it. -->
            <TextBlock x:Name="PickHint" DockPanel.Dock="Bottom" Margin="14,0,12,8"
                       TextTrimming="CharacterEllipsis"
                       Text="Click a session or its bar to select it  ·  ← → switch the chart's reading  ·  Ctrl+click to select more  ·  Delete removes the selected"
                       ToolTip="Click a row in the table, or a bar in the chart, to select that session.&#x0a;← / → switch the chart to the reading before or after - Average FPS, Minutes played and the rest.&#x0a;Ctrl+click selects more than one.&#x0a;Delete presses DELETE (press it again to confirm)." />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="12,2,4,10" Focusable="False">
                <!-- The rows, and over them the column groups' dividing
                     lines, drawn once down the whole table rather than once
                     per row - see ShowTable. Over, not under: a picked row's
                     background would hide them. Never hit, so clicks reach
                     the rows. -->
                <Grid Margin="0,0,8,0">
                    <StackPanel x:Name="Rows" />
                    <Grid x:Name="GroupLines" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
        </Grid>
    </Border>
</ui:PanelWindow>
