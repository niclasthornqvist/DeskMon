<Window x:Class="DeskMon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:DeskMon.Metrics"
        xmlns:ui="clr-namespace:DeskMon.Ui"
        Title="DeskMon"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Consolas"
        FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- For PanelButton, the flat button the other windows use. -->
                <ResourceDictionary Source="Ui/PanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ToolButton, the icon-and-label button, and ToolToggle, the same
                 lit while its window is open, are in Ui/PanelStyles.xaml: the
                 notes window's action row uses them too. -->

            <!-- ToolIcon, the drawn toolbar icons, is in Ui/PanelStyles.xaml:
                 the session history's buttons use the same ones. -->

            <!-- The hover highlight behind a row: a faint rounded strip, the
                 toolbar's hover colour at about half strength so a row under
                 the mouse lifts without competing with its own readings.

                 Pulled a few pixels past the row on each side by negative
                 margins, into the panel's padding, so the text doesn't sit
                 flush against the edge of the strip. Having no content, it
                 asks for no room - the row and the panel keep their size.
                 Not hit-testable: the row it sits in decides what the mouse
                 is over. -->
            <Style x:Key="RowHover" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource Theme.Ov.14}" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- Each row template fades it in and out with its own storyboard
                 rather than a shared one here: a storyboard finds "Hover" by
                 name, and written inside the template's trigger it is certain
                 to look in that template. Faded rather than snapped, quickly in
                 and a little slower out, so running the mouse down the panel
                 leaves a short trail rather than a flicker. Only while the
                 mouse is on the widget: nothing animates on its own over a game. -->
        </ResourceDictionary>
    </Window.Resources>

    <!-- The panel content is a flat list of three item types, and WPF picks the
         template by item type. MainWindow builds that list from
         MetricRegistry.Sections, so adding a metric or a whole section never
         means touching this file. -->
    <Border x:Name="Panel"
            CornerRadius="10"
            BorderThickness="1"
            Padding="12,9"
            MouseLeftButtonDown="Panel_MouseLeftButtonDown"
            MouseMove="Panel_MouseMove"
            MouseLeftButtonUp="Panel_MouseLeftButtonUp"
            LostMouseCapture="Panel_LostMouseCapture">

        <Border.ContextMenu>
            <!-- The same items in the same order as the tray icon's menu
                 (TrayIcon.cs), so it doesn't matter which one you open. Change
                 one, change the other. Hide widget is always "Hide" here: this
                 menu can only be opened on a widget that is showing. -->
            <ContextMenu Style="{StaticResource DarkContextMenu}" Opened="WidgetMenu_Opened">
                <MenuItem Header="Hide widget" Click="MenuHideWidget_Click" />
                <MenuItem x:Name="MenuOnTop" Header="Always on top" IsCheckable="True"
                          Click="MenuOnTop_Click" />
                <MenuItem x:Name="MenuLocked" Header="Lock position" IsCheckable="True"
                          Click="MenuLocked_Click" />
                <MenuItem Header="Reset peaks" Click="MenuResetPeaks_Click" />
                <Separator />
                <MenuItem Header="Hardware info" Click="MenuHardware_Click" />
                <MenuItem Header="Versions" Click="MenuVersions_Click" />
                <MenuItem Header="Session history" Click="MenuSessions_Click" />
                <MenuItem x:Name="MenuNotes" Header="Notes" Click="MenuNotes_Click" />
                <MenuItem Header="Open notes folder" Click="MenuNotesFolder_Click" />
                <Separator />
                <MenuItem Header="Settings" Click="MenuSettings_Click" />
                <MenuItem Header="Open settings.json" Click="MenuOpenSettings_Click" />
                <MenuItem Header="Reload settings" Click="MenuReload_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="MenuExit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <DockPanel LastChildFill="True">

            <!-- The windows from the right-click menu that are worth one click
                 rather than two. They are toggles and light up while open.
                 Reset peaks is deliberately not here, only on the menus: one
                 stray click on a button would wipe the peaks for good.

                 Pulled left by exactly the button's own padding, so what lines
                 up with the section titles below is the label text. Aligning
                 the button edges instead would leave "HW" looking indented. -->
            <Grid DockPanel.Dock="Top" Margin="-5,-2,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left">

                <!-- A chip: body with two pins above and below. -->
                <ToggleButton x:Name="ToolHardware" Style="{StaticResource ToolToggle}"
                              ToolTip="Hardware info&#x0a;What the PC is made of, with checks for updates and for settings that hold games back."
                              Click="ToolHardware_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M1.5,2.5 H8.5 V7.5 H1.5 Z
                                    M3.5,0.5 V2.5 M6.5,0.5 V2.5
                                    M3.5,7.5 V9.5 M6.5,7.5 V9.5" />
                        <TextBlock Text="HW" />
                    </StackPanel>
                </ToggleButton>

                <!-- A clock face, for the history of what has been played.
                     This slot was VER: the version number at the right of
                     this row now opens that window itself, and the history
                     is the window worth a button. -->
                <ToggleButton x:Name="ToolSessions" Style="{StaticResource ToolToggle}"
                              ToolTip="Session history&#x0a;Every game session DeskMon has recorded, with scores, charts and a play calendar."
                              Click="ToolSessions_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M0.5,5 A4.5,4.5 0 1 1 9.5,5 A4.5,4.5 0 1 1 0.5,5
                                    M5,2.5 V5 H7" />
                        <TextBlock Text="LOG" />
                    </StackPanel>
                </ToggleButton>

                <!-- A page with its corner turned down - a rectangle alone
                     would be the chip again at this size. -->
                <ToggleButton x:Name="ToolNotes" Style="{StaticResource ToolToggle}"
                              ToolTip="Notes&#x0a;Opens on the game that is running."
                              Click="ToolNotes_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M2.5,0.5 H6.5 L8.5,2.5 V9.5 H2.5 Z
                                    M6.5,0.5 V2.5 H8.5" />
                        <TextBlock Text="NOTES" />
                    </StackPanel>
                </ToggleButton>

                <!-- A cog: a circle with four spokes poking out of it. -->
                <ToggleButton x:Name="ToolSettings" Style="{StaticResource ToolToggle}"
                              ToolTip="Settings&#x0a;The widget's readings, look and alerts, the windows, and how games are measured."
                              Click="ToolSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M2.5,5 A2.5,2.5 0 1 1 7.5,5 A2.5,2.5 0 1 1 2.5,5
                                    M5,0.5 V2 M5,8 V9.5 M0.5,5 H2 M8,5 H9.5" />
                        <TextBlock Text="CFG" />
                    </StackPanel>
                </ToggleButton>

                <!-- Rebuild from the source and restart, for working on DeskMon
                     itself. Collapsed unless DeveloperRebuild is on in
                     settings.json and Build.ps1 is there - see ToolRebuild_Click.
                     A hammer: head across the top, handle down from it. -->
                <Button x:Name="ToolRebuild" Style="{StaticResource ToolButton}"
                        Visibility="Collapsed" Click="ToolRebuild_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M1.5,1.5 H7.5 V4 H1.5 Z M4.5,4 V9.5" />
                        <TextBlock x:Name="ToolRebuildText" Text="BUILD" />
                    </StackPanel>
                </Button>
                </StackPanel>

                <!-- The running version, opposite the buttons. Filled in from
                     Changelog by the window: the number is in the source, not
                     the markup, so there is one place to bump and no second
                     copy to forget. Dim and small - it is here to be checked
                     occasionally, not read.

                     Also the way into the versions window, which used to have
                     a button of its own: the number is the obvious thing to
                     click for "what changed in this version?". -->
                <!-- The clock and the version together at the right of the
                     toolbar. The clock had a row of its own at the bottom of
                     the widget; up here it shares the toolbar's row, and the
                     widget is that much shorter. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- The time, large, with the day and date stacked small beside
                     it - a desk clock rather than a footnote, led by the same
                     accent bar as the section headings so it reads as part of
                     the widget. Ticked over on the minute - see UpdateClock;
                     sized and coloured in ApplyVersionStyle, as both follow
                     settings. -->
                <StackPanel x:Name="ClockPanel" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border x:Name="ClockAccent" Width="3" CornerRadius="1.5" Margin="0,2,7,2" />
                    <TextBlock x:Name="ClockTime" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- The version on the day's line, right after the day
                             name: it used to be a column of its own at the far
                             right of the toolbar, which widened the widget by
                             its whole width. Here it sits above the date, which
                             is the longer line, so it adds none. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClockDay" FontWeight="SemiBold" />
                            <!-- A small chip, not bare text, so it reads as a
                                 button: an outline always, lit in the accent
                                 under the mouse or while its window is open -
                                 see ApplyVersionStyle. The chip takes the
                                 clicks, so its padding counts too. -->
                            <Border x:Name="VersionChip"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0" Padding="6,0,6,1"
                                    CornerRadius="4" BorderThickness="1"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="VersionText_MouseLeftButtonDown"
                                    MouseEnter="VersionText_HoverChanged"
                                    MouseLeave="VersionText_HoverChanged">
                                <TextBlock x:Name="VersionText" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ClockDate" />
                    </StackPanel>
                </StackPanel>
                </StackPanel>
            </Grid>

            <!-- IsSharedSizeScope: the metric rows' MetricSide columns are one
                 width across the panel - see the MetricRow template. -->
            <ItemsControl x:Name="RowsHost" Focusable="False" Grid.IsSharedSizeScope="True">
                <!-- Stacked or side by side, by the WidgetLayout setting - see
                     Ui/SectionsPanel. Found through its Loaded event, since a
                     panel made from a template can't be named here. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ui:SectionsPanel Loaded="SectionsPanel_Loaded" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>

                    <!-- The detected hardware, at the top. -->
                    <DataTemplate DataType="{x:Type m:HeaderRow}">
                        <!-- Trimming is a backstop: the window does re-measure when the
                             names arrive, but an unusually long name should degrade to
                             an ellipsis rather than a very wide widget. -->
                        <StackPanel Margin="0,0,0,3">
                            <TextBlock Text="{Binding CpuName}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="320"
                                       Foreground="{Binding Brush}"
                                       FontSize="{Binding FontSize}" />
                            <TextBlock Text="{Binding GpuName}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="320"
                                       Visibility="{Binding GpuVisibility}"
                                       Foreground="{Binding Brush}"
                                       FontSize="{Binding FontSize}" />
                        </StackPanel>
                    </DataTemplate>

                    <!-- "USAGE" / "TEMPERATURE", with a separator above all but the first. -->
                    <DataTemplate DataType="{x:Type m:SectionRow}">
                        <StackPanel>
                            <Border Height="1"
                                    Background="{Binding SeparatorBrush}"
                                    Visibility="{Binding SeparatorVisibility}"
                                    Margin="{Binding SeparatorMargin}" />
                            <!-- Clicking anywhere on this row folds the section away;
                                 the arrow at the end says which way it is. Background
                                 is set so the whole strip is clickable, not just the
                                 glyphs. -->
                            <!-- A hand, since a heading is both a button (click to
                                 fold) and a handle (drag to move the section). -->
                            <Grid x:Name="Strip" Margin="{Binding TitleMargin}" Background="Transparent"
                                  ToolTip="{Binding Tooltip}" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- First, so it is drawn behind the heading. -->
                                <Border x:Name="Hover" Grid.ColumnSpan="3" Margin="-5,-2,-4,-2"
                                        Style="{StaticResource RowHover}" />

                                <!-- While the heading is being dragged: the hover
                                     strip at double strength, held for the whole
                                     drag. A separate border because the hover one's
                                     opacity belongs to its fade animations. -->
                                <Border x:Name="Lifted" Grid.ColumnSpan="3" Margin="-5,-2,-4,-2"
                                        Style="{StaticResource RowHover}"
                                        Background="{DynamicResource Theme.Ov.2E}" />

                                <!-- The section's icon, drawn like the toolbar's and
                                     in the heading's own colour so the two read as
                                     one label. Collapsed for a section that has none,
                                     so the title doesn't shift right for nothing.

                                     The paths are designed on an 11 x 11 grid; the
                                     Viewbox scales that whole grid to IconSize, which
                                     follows the font. Scaling the grid rather than
                                     each path keeps the icons' proportions to one
                                     another - the thermometer stays narrower than
                                     the gamepad - and thickens the stroke with them,
                                     so a larger icon still matches the bold heading.

                                     The 2px bottom margin lifts it by one: the title
                                     is all capitals, which sit above the middle of
                                     their line box because the space below them is
                                     reserved for descenders the heading never uses.
                                     Centring both boxes alone leaves the icon looking
                                     low. -->
                                <!-- The accent and the icon share the first column,
                                     so the title starts after both. The accent is a
                                     short gradient bar before the icon - see
                                     SectionRow.AccentBrush - lifted 2px like the icon
                                     so the two sit level. -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="{Binding AccentHeight}"
                                        CornerRadius="1.5"
                                        Margin="0,0,6,2"
                                        VerticalAlignment="Center"
                                        Background="{Binding AccentBrush}"
                                        Visibility="{Binding AccentVisibility}" />
                                <Viewbox Grid.Column="0"
                                         Width="{Binding IconSize}" Height="{Binding IconSize}"
                                         Visibility="{Binding IconVisibility}"
                                         Margin="0,0,6,2"
                                         VerticalAlignment="Center">
                                    <Canvas Width="11" Height="11">
                                        <Path Data="{Binding Icon}"
                                              Stroke="{Binding Brush}"
                                              StrokeThickness="1.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                </StackPanel>

                                <!-- The game section's title carries the game's name,
                                     so it needs the same trimming guard as the header.
                                     Centred against the icon - left at the default it
                                     sat at the top of the row, above the icon.

                                     Then moved down 2px by eye: centring the boxes
                                     still left the capitals reading high next to the
                                     icon. A render transform rather than a margin,
                                     because it moves the text without moving the
                                     layout - a margin on a centred element shifts it
                                     by half and makes the whole row taller. -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="320"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Brush}"
                                           FontSize="{Binding FontSize}"
                                           FontWeight="SemiBold">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="2" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Indicator}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Brush}"
                                           FontSize="{Binding IndicatorFontSize}" />
                            </Grid>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Strip" Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="Lifted" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- One measured value. Indented so it reads as part of the section.
                         Background is set so a row that can unfold is clickable
                         across the whole strip, not just on the arrow. -->
                    <!-- ToolTip says what the row measures, the levels it turns
                         amber and red at, and what a click unfolds - see
                         MetricRow.Tooltip. A row with none of those falls
                         through to the panel's own tooltip. -->
                    <DataTemplate DataType="{x:Type m:MetricRow}">
                        <Grid x:Name="Strip" Margin="9,2,0,2" Background="Transparent"
                              ToolTip="{Binding Tooltip}">
                            <!-- Label on the left, peak and arrow on the right,
                                 value and bar in the middle. The two sides share
                                 one width (SharedSizeGroup, scoped on RowsHost):
                                 the label side is wider than the peak side, and
                                 with each at its own width the middle sat left
                                 of the row's centre. Equal, it is the centre -
                                 and the row spreads across a widget made wider
                                 by a long sensor name or a heading. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetricSide" />  <!-- label -->
                                <ColumnDefinition Width="*" />                                   <!-- value and bar -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetricSide" />  <!-- peak and arrow -->
                            </Grid.ColumnDefinitions>
                            <!-- The value and bar in one of two layouts, and only
                                 the one in use is built: a template each, picked by
                                 ValueInBar. Both used to sit here with one collapsed,
                                 and the hidden one's dozen elements per row still
                                 took every tick's value through their bindings. -->
                            <Grid.Resources>
                                <DataTemplate x:Key="BesideBar">
                                    <!-- The value beside its bar, for ValueInBar off. -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                    <!-- Tabular digits, every one the same width, so a
                                         right-aligned value doesn't shuffle sideways as
                                         a 1 becomes an 8. -->
                                    <!-- MinWidth, not Width: a value wider than the
                                         setting - "4850 MHz" under CPU - used to spill out
                                         of its box over the bar and past the column's
                                         edge. Now it widens the row instead. -->
                                    <TextBlock x:Name="ValueText"
                                               Text="{Binding Value}"
                                               MinWidth="{Binding ValueWidth}"
                                               TextAlignment="Right"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{Binding ValueBrush}" />

                                    <!-- The track and the peak marker share this grid; the
                                         marker sits outside the track's mask, so on a
                                         segmented bar it is never lost in a gap, and its
                                         negative margins let it stand a little proud of
                                         the bar. -->
                                    <Grid Width="{Binding TrackWidth}"
                                          Visibility="{Binding BarVisibility}"
                                          Height="{Binding TrackHeight}"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center">
                                        <!-- OpacityMask is null on a whole bar and the
                                             block, dot or tick pattern otherwise, cutting
                                             the track and its fill alike. The outline and
                                             its inset are the outlined style's, and
                                             Height is the bar thickness, or a thin
                                             line on the line style - see MetricRow and
                                             UiTheme's ApplyBarStyle. -->
                                        <Border CornerRadius="{Binding BarCorner}"
                                                ClipToBounds="True"
                                                Height="{Binding TrackLineHeight}"
                                                VerticalAlignment="Center"
                                                OpacityMask="{Binding BarMask}"
                                                Background="{Binding TrackBrush}"
                                                BorderBrush="{Binding TrackBorderBrush}"
                                                BorderThickness="{Binding TrackBorderThickness}"
                                                Padding="{Binding TrackPadding}">
                                            <!-- BarWidth is how much of the track is filled,
                                                 from the reading; BarTrackWidth in settings
                                                 is the track it is filled against. The
                                                 stripes, on the striped style, are on the
                                                 fill alone. -->
                                            <Border HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}"
                                                    CornerRadius="{Binding FillCorner}"
                                                    OpacityMask="{Binding FillMask}"
                                                    Background="{Binding BarBrush}" />
                                        </Border>

                                        <!-- The line style's knob, at the end of the fill. -->
                                        <Ellipse HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Width="{Binding KnobSize}"
                                                 Height="{Binding KnobSize}"
                                                 Margin="{Binding KnobMargin}"
                                                 Fill="{Binding KnobBrush}"
                                                 Visibility="{Binding KnobVisibility}" />

                                        <!-- A 2 px core in the gradient's colour at the peak,
                                             lightened, with a 1 px dark edge either side:
                                             4 wide in all. See MetricRow.PeakMarkerBrush. -->
                                        <Border HorizontalAlignment="Left"
                                                Width="4"
                                                CornerRadius="2"
                                                BorderThickness="1"
                                                BorderBrush="{Binding PeakMarkerEdgeBrush}"
                                                Margin="{Binding PeakMarkerMargin}"
                                                Background="{Binding PeakMarkerBrush}"
                                                Visibility="{Binding PeakMarkerVisibility}" />
                                    </Grid>

                                    <!-- An empty twin of the value on the bar's right.
                                         Without it the value and bar were centred as one,
                                         which put the bar itself right of centre by half
                                         the value's width; with the same width on both
                                         sides the bar is the centre. Only beside a bar, so
                                         a row without one still centres its value. Bound
                                         to the value's actual width rather than the
                                         setting, so a wider value is still balanced and
                                         the bar stays in the middle on every row. -->
                                    <Border Width="{Binding ActualWidth, ElementName=ValueText}"
                                            Visibility="{Binding BarVisibility}"
                                            Margin="10,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate x:Key="InsideBar">
                                    <!-- The value inside its bar (ValueInBar): the bar is
                                         the middle 90% of the room between label and
                                         peak, 5% either side, and the number sits in its
                                         middle. MinWidth asks for the bar length setting
                                         plus those margins, so a widget sized to its
                                         content still leaves them; a wider widget widens
                                         the bar. The fill, peak tick and knob are placed
                                         by share, two star columns each, since the bar's
                                         pixel width is the layout's - see MetricRow. -->
                                    <!-- MinWidth: the bar length setting, or wide enough
                                         for the number with room each side, whichever
                                         is more - see InBarWidth. -->
                                    <Grid Margin="6,0,6,0">
                                        <Grid.MinWidth>
                                            <MultiBinding Converter="{x:Static ui:InBarWidth.Instance}">
                                                <Binding Path="InBarMinWidth" />
                                                <Binding Path="ActualWidth" ElementName="InBarValue" />
                                            </MultiBinding>
                                        </Grid.MinWidth>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="90*" />
                                            <ColumnDefinition Width="5*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="1" Height="{Binding InBarHeight}" VerticalAlignment="Center">
                                            <Border CornerRadius="{Binding BarCorner}"
                                                    ClipToBounds="True"
                                                    Height="{Binding TrackLineHeight}"
                                                    VerticalAlignment="Center"
                                                    OpacityMask="{Binding BarMask}"
                                                    Background="{Binding TrackBrush}"
                                                    BorderBrush="{Binding TrackBorderBrush}"
                                                    BorderThickness="{Binding TrackBorderThickness}"
                                                    Padding="{Binding TrackPadding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding FillShare}" />
                                                        <ColumnDefinition Width="{Binding RestShare}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="{Binding FillCorner}"
                                                            OpacityMask="{Binding FillMask}"
                                                            Background="{Binding InBarFillBrush}" />
                                                </Grid>
                                            </Border>

                                            <!-- The peak tick, at the peak's share of the bar. -->
                                            <Grid Visibility="{Binding PeakMarkerVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding PeakShare}" />
                                                    <ColumnDefinition Width="{Binding PeakRestShare}" />
                                                </Grid.ColumnDefinitions>
                                                <Border HorizontalAlignment="Right" Width="4" CornerRadius="2"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding PeakMarkerEdgeBrush}"
                                                        Margin="0,-2,-2,-2"
                                                        Background="{Binding PeakMarkerBrush}" />
                                            </Grid>

                                            <!-- The line style's knob, on the end of the fill. -->
                                            <Grid Visibility="{Binding KnobVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding FillShare}" />
                                                    <ColumnDefinition Width="{Binding RestShare}" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         Width="{Binding KnobSize}" Height="{Binding KnobSize}"
                                                         Margin="{Binding InBarKnobMargin}"
                                                         Fill="{Binding KnobBrush}" />
                                            </Grid>

                                            <!-- The number, in the bar's middle, with a solid
                                                 outline in the window colour - a shadow
                                                 alone left it hard to read over the bright
                                                 fill. See OutlinedText. Bold, so the
                                                 letters stay thick inside the outline. -->
                                            <ui:OutlinedText x:Name="InBarValue"
                                                             Text="{Binding Value}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             FontWeight="Bold"
                                                             Fill="{Binding InBarValueBrush}"
                                                             Stroke="{Binding InBarOutlineBrush}"
                                                             StrokeThickness="3" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </Grid.Resources>


                            <!-- First, so it is drawn behind the row. -->
                            <Border x:Name="Hover" Grid.ColumnSpan="3" Margin="-5,-2,-4,-2"
                                    Style="{StaticResource RowHover}" />

                            <TextBlock x:Name="LabelText" Grid.Column="0"
                                       Text="{Binding Label}"
                                       Width="{Binding LabelWidth}"
                                       Padding="{Binding LabelPadding}"
                                       Opacity="{Binding ContentOpacity}"
                                       Foreground="{Binding LabelBrush}" />

                            <!-- A warning the number can't show, such as the CPU
                                 slowing itself down - see Metric.Flag. Inside the
                                 label's column, at its far end, so the values and
                                 bars still line up with every other row. -->
                            <TextBlock Grid.Column="0"
                                       Text="▼"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       FontSize="{Binding PeakFontSize}"
                                       Foreground="{Binding FlagBrush}"
                                       Visibility="{Binding FlagVisibility}"
                                       ToolTip="{Binding FlagTooltip}" />

                            <!-- Faded with the label and peak while the row reads
                                 n/a - see MetricRow.ContentOpacity. Not the flag or
                                 the hover strip, which mean something either way. -->
                            <ContentControl Grid.Column="1" Content="{Binding}"
                                            Opacity="{Binding ContentOpacity}"
                                            Focusable="False" IsTabStop="False"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource BesideBar}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValueInBar}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource InsideBar}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <!-- The worst reading this row has seen. Dim and
                                 unitless: it is history next to a live number, and
                                 the value beside it already names the unit. -->
                            <!-- Right-aligned in its side, so the peaks end at the
                                 row's right edge whatever the label side's width. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        Opacity="{Binding ContentOpacity}"
                                        HorizontalAlignment="Right">
                            <!-- MinWidth for the same reason as the value: a
                                 long peak ("4850") ran past the column's edge
                                 into the next section. The shared side column
                                 then widens every row's peaks alike. On the box,
                                 with the icon and figure right-aligned inside it,
                                 so the icon stays against the figure however
                                 short it is. Transparent, so the whole box
                                 shows the tooltip, not only the strokes. -->
                            <Border Visibility="{Binding PeakVisibility}"
                                    MinWidth="{Binding PeakWidth}"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding PeakTooltip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- A small chart with a dot on its top (or its
                                         bottom, where low is worse) - see MetricRow.PeakIcon. -->
                                    <Path Data="{Binding PeakIcon}"
                                          Visibility="{Binding PeakIconVisibility}"
                                          Stroke="{Binding PeakBrush}"
                                          StrokeThickness="1.1"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="{Binding PeakIconSize}"
                                          Height="{Binding PeakIconSize}"
                                          Stretch="Uniform"
                                          Margin="0,0,3,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Peak}"
                                               VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{Binding PeakBrush}"
                                               FontSize="{Binding PeakFontSize}" />
                                </StackPanel>
                            </Border>

                            <!-- Only present on a row that has something folded
                                 behind it - a sensor list, or rows like FPS's
                                 lows; everything else keeps its full drag area. -->
                            <TextBlock Text="{Binding Indicator}"
                                       Visibility="{Binding IndicatorVisibility}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding LabelBrush}"
                                       FontSize="{Binding IndicatorFontSize}"
                                       ToolTip="{Binding IndicatorTooltip}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- The label brightens to the heading colour too, so
                                 it is clear which name the highlight belongs to. -->
                            <Trigger SourceName="Strip" Property="IsMouseOver" Value="True">
                                <Setter TargetName="LabelText" Property="Foreground"
                                        Value="{Binding LabelHoverBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- A row that unfolds something is a button as well as
                                 a reading; the hand says so before it is clicked. -->
                            <DataTrigger Binding="{Binding CanExpand}" Value="True">
                                <Setter TargetName="Strip" Property="Cursor" Value="Hand" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- One line of an unfolded metric's sensor list. Indented past
                         the metric rows, and the name column takes what it needs
                         since sensor names are longer than a label like "CPU". -->
                    <DataTemplate DataType="{x:Type m:DetailRow}">
                        <!-- Right-click opens the row's own menu - End, for a
                             program in the memory lists - instead of the widget's. -->
                        <Grid x:Name="Strip" Margin="22,1,0,1" Background="Transparent"
                              ToolTip="{Binding Tooltip}"
                              MouseRightButtonUp="DetailRow_MouseRightButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Hover" Grid.ColumnSpan="2" Margin="-5,-1,-4,-1"
                                    Style="{StaticResource RowHover}" />

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="320"
                                       Foreground="{Binding LabelBrush}"
                                       FontSize="{Binding FontSize}" />

                            <!-- MinWidth, not Width: the list's values carry a
                                 decimal and a unit ("4850.0 MHz"), often wider
                                 than the row's value column. A fixed width let
                                 them spill past the column into the next section
                                 side by side; this way the column widens to fit.
                                 Still right-aligned, so their ends line up. -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       MinWidth="{Binding ValueWidth}"
                                       Margin="8,0,0,0"
                                       Typography.NumeralAlignment="Tabular"
                                       TextAlignment="Right"
                                       Foreground="{Binding ValueBrush}"
                                       FontSize="{Binding FontSize}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Strip" Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                </ItemsControl.Resources>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
