<ui:PanelWindow x:Class="DeskMon.HardwareWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:DeskMon.Ui"
                Title="Hardware"
                Width="560" Height="680"
                MinWidth="360" MinHeight="200"
                ShowInTaskbar="False"
                ShowActivated="False"
                TextOptions.TextFormattingMode="Display"
                FontFamily="Consolas">

    <ui:PanelWindow.Resources>
        <ResourceDictionary Source="Ui/PanelStyles.xaml" />
    </ui:PanelWindow.Resources>

    <Border x:Name="Panel" CornerRadius="10" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <Grid x:Name="HeaderBar" DockPanel.Dock="Top" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0"
                           Text="HARDWARE"
                           Margin="12,8,8,6"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,6,0">
                    <Button Style="{StaticResource PanelButton}"
                            Content="&#x2715;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="HeaderRule" DockPanel.Dock="Top" Height="1" Margin="12,0,12,0" />

            <!-- What can be done here, in the row every window has under its
                 header (ActionRow, in PanelStyles.xaml). It was a bare ⤓ beside
                 the close button, which said nothing until hovered. -->
            <StackPanel Style="{StaticResource ActionRow}" Orientation="Horizontal">
                <!-- Two pages, one over the other: copy. -->
                <Button Style="{StaticResource ToolButton}"
                        ToolTip="Copy everything to the clipboard" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}"
                              Data="M3.5,0.5 H9.5 V7.5 H3.5 Z M1.5,2.5 V9.5 H7.5" />
                        <TextBlock Text="COPY" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- One row per fact. Values can be long (a full GPU name, a BIOS
                 string), so they wrap rather than being cut off.

                 In a scroller, like every other window's list: the window sizes
                 to its rows, and a machine with four sticks, several drives and
                 a few network adapters - or a long Missing list - used to run
                 the bottom of it off the screen with no way to reach it. The
                 window stops at the screen's edge (FitToScreen) and the rest
                 scrolls. The right margin moves inside, as in the other
                 windows, so the scroll bar has a gutter of its own.

                 One fixed height rather than sized to the rows: it opened at
                 one line of "Reading…" and then grew as the rows arrived. -->
            <Grid>
            <ScrollViewer x:Name="RowsScroller"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="12,2,4,10" Focusable="False">
            <!-- One shared-size scope, so every row's status column takes the
                 widest status's width and the marks and words start at the same
                 place on every row, instead of each hugging its own text. -->
            <ItemsControl x:Name="Rows" Margin="0,0,8,0" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Headings, items, notes and the gaming ticks share one
                             template: each part shows only on its own kind of
                             row - see InfoRow. -->
                        <StackPanel Margin="{Binding RowMargin}">
                        <!-- A group's heading - "BOARD & BIOS" with a thin line
                             running on from it, like the widget's sections - so
                             the window reads as a few groups, not one long list. -->
                        <Grid Visibility="{Binding HeadingVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="{Binding HeadingFontSize}"
                                       Foreground="{Binding LabelBrush}"
                                       VerticalAlignment="Center" />
                            <!-- In the accent, strong by the heading and fading
                                 to the right, matching the line between the
                                 sessions window's chart and table, so the groups
                                 stand apart more than the grey rules under each
                                 row. -->
                            <Border Grid.Column="1" Height="1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource Theme.AccentColor.80}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Theme.AccentColor.14}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- An item: label, logo, name with its grey detail line
                             under it, and its status at the right. A faint rule
                             under each, so the eye can follow a row across to
                             its status. The name's tooltip has the full text
                             behind every short form. -->
                        <Border Visibility="{Binding ItemVisibility}"
                                BorderBrush="{Binding RuleBrush}" BorderThickness="{Binding RuleThickness}"
                                Padding="0,4,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                                </Grid.ColumnDefinitions>

                                <!-- Label, logo and status are centred on the row's
                                     height, so a row with a detail line looks the
                                     same as one without - they sat on the first
                                     line before, and only one-line rows looked
                                     centred. -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Width="{Binding LabelWidth}"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding LabelBrush}" />

                                <!-- The logo in a column of one width on every
                                     row, so the names line up. The Path only
                                     gets maximums, and Uniform stretch fits each
                                     shape inside them: a square mark fills the
                                     height, a wide wordmark hits the width and
                                     comes out shorter, centred in the fixed-height
                                     Grid. -->
                                <Grid Grid.Column="1"
                                      Width="{Binding LogoColumnWidth}"
                                      Height="{Binding LogoHeight}"
                                      VerticalAlignment="Center"
                                      Margin="{Binding LogoMargin}">
                                    <Path Data="{Binding LogoShape}"
                                          Fill="{Binding LogoFill}"
                                          MaxHeight="{Binding LogoHeight}"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="2" Background="Transparent" ToolTip="{Binding ToolTip}">
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding NameBrush}" />
                                    <TextBlock Text="{Binding Detail}"
                                               Visibility="{Binding DetailVisibility}"
                                               TextWrapping="Wrap"
                                               FontSize="{Binding DetailFontSize}"
                                               Margin="0,1,0,0"
                                               Foreground="{Binding DetailBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                            Visibility="{Binding StatusVisibility}"
                                            Background="Transparent"
                                            ToolTip="{Binding StatusFull}">
                                    <Grid Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding StatusTint}" />
                                        <Path Data="{Binding StatusMark}" Stroke="{Binding StatusBrush}"
                                              Width="12" Height="12" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusTextBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Ping again, on the ping test's row once it
                                         has an answer, right after the result it
                                         repeats. -->
                                    <Button Style="{StaticResource PanelButton}"
                                            Width="18" Height="16" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding RetryVisibility}"
                                            ToolTip="Ping again"
                                            Click="PingAgain_Click">
                                        <Path Data="M8.46,0.6 V3 H6.06 M8.46,3 A4,4 0 1 0 8.94,5.7"
                                              Width="10" Height="10" StrokeThickness="1.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- A note: the full sentence of a check that is a
                             warning or worse, in its colour on a faint tint of
                             it, so a problem can't be missed in a list of
                             short words. -->
                        <Border Visibility="{Binding NoteVisibility}"
                                Margin="{Binding NoteMargin}"
                                CornerRadius="{DynamicResource Theme.CornerSmall}"
                                Background="{Binding NoteTint}"
                                Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{Binding StatusMark}" Stroke="{Binding StatusBrush}"
                                      Width="12" Height="12" StrokeThickness="1.6" Margin="0,1,6,0"
                                      VerticalAlignment="Top"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"
                                           Foreground="{Binding StatusBrush}" />
                            </Grid>
                        </Border>

                        <!-- The gaming checks: ticks two to a line, the gamepad
                             where an item's label would be. Each tick's tooltip
                             has its full sentence. -->
                        <Grid Visibility="{Binding TogglesVisibility}" Margin="0,3,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="{Binding LabelWidth}" Height="{Binding LogoHeight}" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Path Data="{Binding LogoShape}" Fill="{Binding LogoFill}"
                                      MaxHeight="{Binding LogoHeight}" Stretch="Uniform"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Toggles}" Focusable="False"
                                          Margin="{Binding TogglesMargin}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2"
                                                    Background="Transparent" ToolTip="{Binding Full}">
                                            <Grid Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse Fill="{Binding MarkTint}" />
                                                <Path Data="{Binding Mark}" Stroke="{Binding MarkBrush}"
                                                      Width="12" Height="12" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- While the facts are gathered: a chip in a spinning ring over
                 what it is doing, in the middle of the space the rows will
                 take - see ShowLoading. A chip because it is this window's
                 own motif (the banner's too), so the wait already looks like
                 the window it opens into. Colours are set in ApplyTheme. -->
            <StackPanel x:Name="Loading" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <!-- The ring's track, then the arc that runs round it. Both
                         on a radius of 30 about the centre, so the arc sits
                         exactly on the track. -->
                    <Ellipse x:Name="LoadingTrack" Margin="1" StrokeThickness="2" />
                    <Path x:Name="LoadingArc" Data="M32,2 A30,30 0 0 1 62,32" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="LoadingSpin" />
                        </Path.RenderTransform>
                    </Path>
                    <Canvas Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="LoadingPins" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M10,1 V5 M15,1 V5 M20,1 V5 M10,25 V29 M15,25 V29 M20,25 V29 M1,10 H5 M1,15 H5 M1,20 H5 M25,10 H29 M25,15 H29 M25,20 H29" />
                        <Rectangle x:Name="LoadingBody" Canvas.Left="5" Canvas.Top="5" Width="20" Height="20"
                                   RadiusX="3" RadiusY="3" StrokeThickness="1.5" />
                        <Rectangle x:Name="LoadingCore" Canvas.Left="10" Canvas.Top="10" Width="10" Height="10"
                                   RadiusX="1.5" RadiusY="1.5" />
                    </Canvas>
                </Grid>
                <TextBlock x:Name="LoadingText" Text="Reading hardware…"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</ui:PanelWindow>
