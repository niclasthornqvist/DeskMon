<Application x:Class="DeskMon.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: App.xaml.cs creates the window itself so the
         single-instance check runs before anything is shown.

         No resources here either: with no StartupUri the build generates no
         InitializeComponent for this file, so anything put here is never
         loaded. Application-wide styles are merged in from code - see
         OnStartup. -->
    <Application.Resources />
</Application>
